    {
      "name": "Choose random event",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "const events = pm.response.json().events;\r",
              "\r",
              "// Random 1 event\r",
              "let index1 = Math.floor(Math.random() * events.length);\r",
              "\r",
              "// Récupérer les ids \r",
              "let eventId1 = events[index1].id;\r",
              "\r",
              "// Stocker les variables de collection\r",
              "pm.collectionVariables.set(\"eventId1\", eventId1);\r",
              "\r",
              "console.log(\"Event 1 :\", eventId1);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [],
            "type": "text/javascript"
          }
        }
      ],
